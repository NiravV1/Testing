                    Size = UDim2.new(1, 0, 0, 20),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Color3.fromRGB(180, 180, 180),
                    TextSize = 13,
                    Font = Enum.Font.Code,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 7,
                    Parent = textboxFrame
                })
                local box = utility.create("TextBox", {
                    Size = UDim2.new(1, 0, 0, 24),
                    Position = UDim2.new(0, 0, 0, 22),
                    BackgroundColor3 = Color3.fromRGB(25, 25, 25),
                    BorderSizePixel = 0,
                    PlaceholderText = placeholder or "...",
                    Text = "",
                    TextColor3 = Color3.fromRGB(220, 220, 220),
                    PlaceholderColor3 = Color3.fromRGB(80, 80, 80),
                    TextSize = 13,
                    Font = Enum.Font.Code,
                    ZIndex = 7,
                    Parent = textboxFrame
                })
                utility.stroke(box, Color3.fromRGB(50, 50, 50), 1)
                utility.create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = box})
                box.FocusLost:Connect(function()
                    library.flags[flag] = box.Text
                    if callback then callback(box.Text) end
                end)
            end
           
            -- MULTI-SELECT DROPDOWN
            function sectionActions:Dropdown(text, flag, list, callbackOrMulti, callback)
                local multi = false
                local cb = nil
                if typeof(callbackOrMulti) == "boolean" then
                    multi = callbackOrMulti
                    cb = callback
                elseif typeof(callbackOrMulti) == "function" then cb = callbackOrMulti
                end
                local dropdown = utility.create("Frame", {
                    Size = UDim2.new(1, 0, 0, 50),
                    BackgroundTransparency = 1,
                    ZIndex = 6,
                    Parent = items
                })
                utility.create("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 20),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Color3.fromRGB(180, 180, 180),
                    TextSize = 13,
                    Font = Enum.Font.Code,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 7,
                    Parent = dropdown
                })
                local btn = utility.create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 24),
                    Position = UDim2.new(0, 0, 0, 22),
                    BackgroundColor3 = Color3.fromRGB(25, 25, 25),
                    BorderSizePixel = 0,
                    Text = "Select...",
                    TextColor3 = Color3.fromRGB(200, 200, 200),
                    TextSize = 13,
                    Font = Enum.Font.Code,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 7,
                    Parent = dropdown
                })
                utility.stroke(btn, Color3.fromRGB(50, 50, 50), 1)
                utility.create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = btn})
                utility.create("TextLabel", {
                    Size = UDim2.new(0, 30, 1, 0),
                    Position = UDim2.new(1, -35, 0, 0),
                    BackgroundTransparency = 1,
                    Text = "▼",
                    TextColor3 = Color3.fromRGB(120, 120, 120),
                    TextSize = 12,
                    Font = Enum.Font.Code,
                    ZIndex = 8,
                    Parent = btn
                })
               
                local maxDropdownHeight = 180
                local contentHeight = #list * 26
                local listFrame = utility.create("ScrollingFrame", {
                    Size = UDim2.new(1, 0, 0, 0),
                    Position = UDim2.new(0, 0, 1, 4),
                    BackgroundColor3 = Color3.fromRGB(20, 20, 20),
                    BorderSizePixel = 0,
                    Visible = false,
                    ZIndex = 11,
                    ScrollBarThickness = 4,
                    ScrollBarImageColor3 = library.accent,
                    ScrollBarImageTransparency = 0.3,
                    CanvasSize = UDim2.new(1, 0, 0, contentHeight),
                    Parent = btn
                })
                utility.stroke(listFrame, Color3.fromRGB(50, 50, 50), 1)
                utility.create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = listFrame})
                utility.create("UIListLayout", {
                    Padding = UDim.new(0, 2),
                    Parent = listFrame
                })
               
                local opened = false
                btn.MouseButton1Click:Connect(function()
                    opened = not opened
                    listFrame.Visible = opened
                    if opened then
                        listFrame.Size = UDim2.new(1, 0, 0, math.min(contentHeight, maxDropdownHeight))
                        listFrame.CanvasPosition = Vector2.new(0, 0)
                    else
                        listFrame.Size = UDim2.new(1, 0, 0, 0)
                    end
                end)
                if not multi then
                    for _, v in next, list do
                        local item = utility.create("TextButton", {
                            Size = UDim2.new(1, 0, 0, 24),
                            BackgroundColor3 = Color3.fromRGB(20, 20, 20),
                            BorderSizePixel = 0,
                            Text = " ".. v,
                            TextColor3 = Color3.fromRGB(160, 160, 160),
                            TextSize = 13,
                            Font = Enum.Font.Code,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            ZIndex = 12,
                            Parent = listFrame
                        })
                        utility.hover(item, Color3.fromRGB(20, 20, 20), Color3.fromRGB(30, 30, 30))
                        item.MouseButton1Click:Connect(function()
                            btn.Text = " ".. v
                            opened = false
                            listFrame.Visible = false
                            listFrame.Size = UDim2.new(1, 0, 0, 0)
                            library.flags[flag] = v
                            if cb then cb(v) end
                        end)
                    end
                else
                    local selected = library.flags[flag]
                    if not selected or typeof(selected) ~= "table" then
                        selected = {}
                        library.flags[flag] = selected
                    end
                    local function updateButtonText()
                        if #selected == 0 then
                            btn.Text = " Select..."
                        elseif #selected == 1 then
                            btn.Text = " ".. selected[1]
                        elseif #selected <= 2 then
                            btn.Text = " ".. table.concat(selected, ", ")
                        else
                            btn.Text = " ".. #selected.. " selected"
                        end
                    end
                    updateButtonText()
                    for _, v in next, list do
                        local item = utility.create("TextButton", {
                            Size = UDim2.new(1, 0, 0, 24),
                            BackgroundColor3 = Color3.fromRGB(20, 20, 20),
                            BorderSizePixel = 0,
                            Text = "",
                            ZIndex = 12,
                            Parent = listFrame
                        })
                        utility.hover(item, Color3.fromRGB(20, 20, 20), Color3.fromRGB(30, 30, 30))
                       
                        local itemText = utility.create("TextLabel", {
                            Size = UDim2.new(1, -30, 1, 0),
                            Position = UDim2.new(0, 8, 0, 0),
                            BackgroundTransparency = 1,
                            Text = v,
                            TextColor3 = Color3.fromRGB(160, 160, 160),
                            TextSize = 13,
                            Font = Enum.Font.Code,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            ZIndex = 13,
                            Parent = item
                        })
                        local check = utility.create("TextLabel", {
                            Size = UDim2.new(0, 20, 1, 0),
                            Position = UDim2.new(1, -25, 0, 0),
                            BackgroundTransparency = 1,
                            Text = "●",
                            TextColor3 = library.accent,
                            TextSize = 14,
                            Font = Enum.Font.Code,
                            TextXAlignment = Enum.TextXAlignment.Center,
                            ZIndex = 13,
                            Parent = item
                        })
                        check.Visible = table.find(selected, v) ~= nil
                        item.MouseButton1Click:Connect(function()
                            local idx = table.find(selected, v)
                            if idx then
                                table.remove(selected, idx)
                                check.Visible = false
                            else
                                table.insert(selected, v)
                                check.Visible = true
                            end
                            updateButtonText()
                            if cb then cb(selected) end
                        end)
                    end
                end
            end
           
            -- CHIYO STYLE SLIDER: thin bar, centered value/max text
            function sectionActions:Slider(text, flag, min, max, default, callback)
                local slider = utility.create("Frame", {
                    Size = UDim2.new(1, 0, 0, 45),
                    BackgroundTransparency = 1,
                    ZIndex = 6,
                    Parent = items
                })
                utility.create("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 18),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Color3.fromRGB(180, 180, 180),
                    TextSize = 13,
                    Font = Enum.Font.Code,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 7,
                    Parent = slider
                })
               
                local sliderBar = utility.create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 18),
                    Position = UDim2.new(0, 0, 0, 22),
                    BackgroundColor3 = Color3.fromRGB(25, 25, 25),
                    Text = "",
                    ZIndex = 7,
                    Parent = slider
                })
                utility.stroke(sliderBar, Color3.fromRGB(50, 50, 50), 1)
                utility.create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = sliderBar})
                sliderBar.ClipsDescendants = true
               
                local fill = utility.create("Frame", {
                    Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
                    BackgroundColor3 = library.accent,
                    BorderSizePixel = 0,
                    ZIndex = 8,
                    Parent = sliderBar
                })
                local fillGradient = utility.create("UIGradient", {
                    Color = utility.gradient(library.outline),
                    Rotation = 0,
                    Parent = fill
                })
               
                local val = utility.create("TextLabel", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Size = UDim2.new(1, 0, 1, 0),
                    Position = UDim2.new(0.5, 0, 0.5, 0),
                    BackgroundTransparency = 1,
                    Text = string.format("%.1fs/%.1fs", default, max),
                    TextColor3 = Color3.fromRGB(255, 255, 255),
                    TextSize = 12,
                    Font = Enum.Font.Code,
                    TextXAlignment = Enum.TextXAlignment.Center,
                    ZIndex = 9,
                    Parent = sliderBar
                })
               
                local function update(input)
                    local perc = math.clamp((input.Position.X - sliderBar.AbsolutePosition.X) / sliderBar.AbsoluteSize.X, 0, 1)
                    local rawValue = min + (max - min) * perc
                    local value = tonumber(string.format("%.1f", rawValue))
                    utility.tween(fill, {0.1}, {Size = UDim2.new(perc, 0, 1, 0)})
                    val.Text = string.format("%.1fs/%.1fs", value, max)
                    library.flags[flag] = value
                    if callback then callback(value) end
                end
               
                local dragging = false
                sliderBar.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        update(input)
                    end
                end)
                services.UserInputService.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        update(input)
                    end
                end)
                services.UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)
                library.flags[flag] = default
            end
           
            function sectionActions:Button(text, callback)
                local btn = utility.create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 32),
                    BackgroundColor3 = Color3.fromRGB(25, 25, 25),
                    BorderSizePixel = 0,
                    Text = text,
                    TextColor3 = Color3.fromRGB(200, 200, 200),
                    TextSize = 13,
                    Font = Enum.Font.Code,
                    ZIndex = 6,
                    Parent = items
                })
                utility.stroke(btn, Color3.fromRGB(50, 50, 50), 1)
                utility.create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = btn})
                utility.hover(btn, Color3.fromRGB(25, 25, 25), Color3.fromRGB(35, 35, 35))
                btn.MouseButton1Click:Connect(function()
                    if callback then callback() end
                end)
            end
           
            return sectionActions
        end
        return tabActions
    end
   
    -- Global search logic
    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        local query = string.lower(searchBox.Text)
        if currentTab and currentTab.LeftCol and currentTab.RightCol then
            local cols = {currentTab.LeftCol, currentTab.RightCol}
            for _, col in ipairs(cols) do
                for _, child in ipairs(col:GetChildren()) do
                    if child.Name == "ZalSection" then
                        local title = child:FindFirstChildWhichIsA("TextLabel")
                        if title then
                            local match = (query == "") or string.find(string.lower(title.Text), query, 1, true)
                            child.Visible = match
                        end
                    end
                end
                col.CanvasPosition = Vector2.new(0, 0)
            end
            task.delay(0.05, function()
                if currentTab.LeftCol then
                    local leftList = currentTab.LeftCol:FindFirstChild("UIListLayout")
                    if leftList then
                        currentTab.LeftCol.CanvasSize = UDim2.new(0, 0, 0, leftList.AbsoluteContentSize.Y + 20)
                    end
                end
                if currentTab.RightCol then
                    local rightList = currentTab.RightCol:FindFirstChild("UIListLayout")
                    if rightList then
                        currentTab.RightCol.CanvasSize = UDim2.new(0, 0, 0, rightList.AbsoluteContentSize.Y + 20)
                    end
                end
            end)
        end
    end)
   
    return windowActions
end
return library
